// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String   // hashed password
  contracts Contract[]
  gmailConnection GmailConnection?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Contract {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  vendor                String
  status                String   // e.g., "Draft", "Review", "Approved", "Signed", "Expired"
  riskLevel             String   // e.g., "Low", "Medium", "High", "Critical"
  summary               String?  @db.Text
  contractType          String   // e.g., "MSA", "SLA", "NDA", "Purchase Agreement"
  effectiveDate         DateTime
  expiryDate            DateTime
  pdfPath               String?
  fileName              String?  // original PDF filename
  extractedText         String?  @db.Text  // text extracted from PDF
  
  // AI Analysis Fields (Phase 4)
  aiSummary             String?  @db.Text  // AI-generated summary
  aiContractType        String?  // AI-identified contract type
  aiVendor              String?  // AI-identified vendor name
  aiEffectiveDate       DateTime?  // AI-extracted effective date
  aiExpiryDate          DateTime?  // AI-extracted expiry date
  aiRiskLevel           String?  // AI-identified risk level (Low, Medium, High)
  aiKeyTerms            String[]  // Array of key terms
  aiRisks               Json?  // Array of {title, severity, description}
  aiRecommendations     String[]  // Array of recommendations
  analysisStatus        String  @default("PENDING")  // PENDING, COMPLETED, FAILED
  analysisError         String?  // Error message if analysis failed
  
  chatHistory           ChatHistory[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("contracts")
}

model ChatHistory {
  id              String   @id @default(cuid())
  contractId      String
  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userMessage     String   @db.Text
  aiResponse      String   @db.Text
  timestamp       DateTime @default(now())

  @@map("chat_history")
}

model GmailConnection {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailEmail        String
  accessToken       String   @db.Text  // encrypted
  refreshToken      String?  @db.Text  // encrypted
  expiresAt         DateTime?
  connectedAt       DateTime @default(now())
  lastSyncAt        DateTime?
  syncStatus        String   @default("IDLE")  // IDLE, SYNCING, ERROR
  syncError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("gmail_connections")
}
