// Prisma schema for the Orderly procurement platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id          String   @id @default(cuid())
  employeeId  String   @unique
  name        String
  email       String   @unique
  department  String
  role        String   // REQUESTER, MANAGER, PROCUREMENT_OFFICER, ADMIN
  isActive    Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("employees")
}

model User {
  id              String            @id @default(cuid())
  employeeId      String            @unique
  employee        Employee          @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict)
  name            String
  email           String            @unique
  password        String
  role            String            // REQUESTER, MANAGER, PROCUREMENT_OFFICER, ADMIN
  department      String
  requests        PurchaseRequest[] @relation("UserRequests")
  approvals       Approval[]        @relation("UserApprovals")
  purchaseOrders  PurchaseOrder[]   @relation("UserOrders")
  contracts       Contract[]        @relation("UserContracts")
  notifications   Notification[]
  auditLogs       AuditLog[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("users")
}

model PurchaseRequest {
  id                 String          @id @default(cuid())
  requestNumber      String          @unique
  title              String
  description        String          @db.Text
  category           String
  quantity           Int             @default(1)
  estimatedBudget    Float
  department         String
  priority           String          @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  requiredByDate     DateTime
  status             String          @default("PENDING") // PENDING, MANAGER_APPROVED, MANAGER_REJECTED, PROCUREMENT, ORDERED, DELIVERED, COMPLETED, CANCELLED
  requesterId        String
  requester          User            @relation("UserRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  selectedSupplierId String?
  selectedSupplier   Supplier?       @relation(fields: [selectedSupplierId], references: [id])
  selectionReason    String?         @db.Text
  approvals          Approval[]
  purchaseOrders     PurchaseOrder[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("purchase_requests")
}

model Approval {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  approverId        String
  approver          User            @relation("UserApprovals", fields: [approverId], references: [id], onDelete: Cascade)
  decision          String          // APPROVED, REJECTED
  comment           String?         @db.Text
  createdAt         DateTime        @default(now())

  @@map("approvals")
}

model Supplier {
  id                  String            @id @default(cuid())
  name                String
  contactPerson       String
  email               String
  phone               String
  address             String
  category            String
  rating              Float             @default(4.0)
  deliveryPerformance Int               @default(90) // percentage
  paymentTerms        String            @default("Net 30")
  status              String            @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  notes               String?           @db.Text
  purchaseRequests    PurchaseRequest[]
  purchaseOrders      PurchaseOrder[]
  contracts           Contract[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("suppliers")
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  poNumber             String              @unique
  purchaseRequestId    String
  purchaseRequest      PurchaseRequest     @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy            String
  creator              User                @relation("UserOrders", fields: [createdBy], references: [id], onDelete: Cascade)
  totalAmount          Float
  expectedDeliveryDate DateTime
  paymentTerms         String
  shippingInformation  String?             @db.Text
  notes                String?             @db.Text
  status               String              @default("DRAFT") // DRAFT, ISSUED, ACKNOWLEDGED, IN_PROGRESS, DELIVERED, CANCELLED
  items                PurchaseOrderItem[]
  contracts            Contract[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description     String
  quantity        Int
  unitPrice       Float
  totalPrice      Float

  @@map("purchase_order_items")
}

model Contract {
  id              String         @id @default(cuid())
  contractName    String
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  userId          String
  user            User           @relation("UserContracts", fields: [userId], references: [id], onDelete: Cascade)
  contractValue   Float
  startDate       DateTime
  expiryDate      DateTime
  renewalDate     DateTime?
  status          String         @default("ACTIVE") // DRAFT, ACTIVE, EXPIRING_SOON, EXPIRED, TERMINATED
  fileName        String?
  fileUrl         String?
  fileType        String?
  fileSize        Int?
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("contracts")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
