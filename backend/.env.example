# Replace with your actual Neon connection string from the Neon dashboard
DATABASE_URL="postgresql://username:password@localhost:5432/orderly"

# JWT Configuration (REQUIRED - use strong random string, min 16 chars)
JWT_SECRET="your-super-secret-jwt-key-minimum-16-characters-change-in-production"
JWT_EXPIRES_IN="1d"

# Server Configuration
PORT=5000
NODE_ENV="development"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3001"

# AI Service Configuration (Phase 4+, OPTIONAL)
# Get your API key from https://openrouter.ai
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemma-3-27b-it"

# Optional: Google Gemini API for AI features
GEMINI_API_KEY=""