# Database Configuration
# For LOCAL DEVELOPMENT (PostgreSQL installed locally):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orderly?schema=public"
#
# For PRODUCTION (Neon PostgreSQL - get URL from https://console.neon.tech):
