# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/procure_ai"

# JWT Configuration (REQUIRED - use strong random string, min 16 chars)
JWT_SECRET="your-super-secret-jwt-key-minimum-16-characters-change-in-production"
JWT_EXPIRES_IN="1d"

# Server Configuration
PORT=5000
NODE_ENV="development"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"

# AI Service Configuration (Phase 4+)
# Get your API key from https://openrouter.ai
OPENROUTER_API_KEY="sk-or-v1-your-api-key-here"
OPENROUTER_MODEL="google/gemma-3-27b-it"

# Gmail Integration (Phase 6 - Optional)
# Create OAuth app at https://console.cloud.google.com
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/gmail/callback"