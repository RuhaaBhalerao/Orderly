{
  "name": "orderly-backend",
  "version": "1.0.0",
  "description": "Node.js backend for Orderly - procurement operations platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "seed": "tsx prisma/seed.ts",
    "build:render": "tsc && npx prisma db push --accept-data-loss && npx tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "keywords": [
    "orderly",
    "procurement",
    "purchase-requests",
    "supplier-management",
    "purchase-orders"
  ],
  "author": "Orderly",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.8.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "bcrypt": "5.1.1",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "7.0.0",
    "google-auth-library": "^11.0.2",
    "googleapis": "^176.0.0",
    "jsonwebtoken": "9.0.2",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "typescript": "5.2.2",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "prisma": "^5.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "4.6.2"
  }
}
